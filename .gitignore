# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local previews
preview*.svg


# Added by cargo

/target

# Per-machine cargo parallelism cap; local-only, never committed. Capping
# jobs/test threads (half the cores is a reasonable default) keeps a run from
# pinning a shared machine, but the right number is per-machine, so it stays
# ignored rather than committed.
/.cargo/config.toml

# Per-machine nextest thread cap; same rule as /.cargo/config.toml above
# (nextest reads test-threads from here, not from RUST_TEST_THREADS).
/.config/nextest.toml

# macOS
.DS_Store

# Local caches and scratch
.cgr-hash-cache.json
.cgr-dir-mtimes.json
.cgr-parser-fingerprint
.tmp/

# Debugger build artifacts (build_debuggable_binary drops <stem>.dbg next to source)
*.dbg
*.dbg.dSYM/

# Local secrets (Codeberg token, etc.) — never commit
.env
.env.*

# SonarQube Cloud scan artifacts (see .github/workflows/sonarcloud.yml)
/clippy-report.json
/.scannerwork/
