# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local previews
preview*.svg


# Added by cargo

/target

# Per-machine cargo parallelism cap; local-only, never committed.
# Superseded by the Nix dev shell (flake.nix), whose shellHook caps
# RUST_TEST_THREADS/CARGO_BUILD_JOBS adaptively on every machine — kept ignored
# so a stray local override never gets committed.
/.cargo/config.toml

# Nix / direnv
/.direnv/
/result
/result-*

# macOS
.DS_Store

# Local caches and scratch
.cgr-hash-cache.json
.tmp/

# Debugger build artifacts (build_debuggable_binary drops <stem>.dbg next to source)
*.dbg
*.dbg.dSYM/

# Local secrets (Codeberg token, etc.) — never commit
.env
.env.*
